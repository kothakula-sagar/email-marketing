# COPY THIS FILE TO .env ON YOUR FRIEND'S COMPUTER.
# NEVER commit .env (it is ignored by Git).
# Get the exact outgoing SMTP server/port/encryption from cPanel > Email Accounts
# > Connect Devices for support@abra-logistic.com. Don't guess a hostname.
APP_PORT=3000

# EXAMPLE ONLY: replace SMTP_HOST with the server shown in cPanel.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@abra-logistic.com
SMTP_PASS=

# Sender MUST match the authenticated mailbox.
SENDER_EMAIL=support@abra-logistic.com
SENDER_NAME=ABRA LOGISTIC
REPLY_TO_EMAIL=support@abra-logistic.com

# Recipient unsubscribe requests are handled manually in the Customers page.
UNSUBSCRIBE_EMAIL=support@abra-logistic.com
COMPANY_NAME=ABRA LOGISTIC
BUSINESS_ADDRESS=

# Send a test to an email YOU control. Defaults to SMTP_USER if blank.
TEST_EMAIL=

# Conservative limits for a mailbox with bounce notifications.
# Check your hosting plan's actual hourly limit.
SEND_INTERVAL_MS=8000
SEND_DAILY_LIMIT=50
